<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest" IgnorableNamespaces="uap mp">
  <Identity Name="EViewer.ThumbnailRegression" Publisher="CN=Opportunity" Version="1.0.0.0" />
  <mp:PhoneIdentity PhoneProductId="aee1f7f4-d92e-42ba-92e6-93eec9b80543" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>E-Viewer thumbnail regression (offline testhost)</DisplayName>
    <PublisherDisplayName>Opportunity</PublisherDisplayName>
    <Logo>Assets\Store.png</Logo>
  </Properties>
  <Dependencies><TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.16299.0" MaxVersionTested="10.0.22621.0" /></Dependencies>
  <Resources><Resource Language="en" /></Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="ThumbnailRegression.App">
      <uap:VisualElements DisplayName="Offline thumbnail regression" Description="Safe synthetic fixtures only"
          Square150x150Logo="Assets\Medium.png" Square44x44Logo="Assets\TaskBar.png" BackgroundColor="transparent">
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
